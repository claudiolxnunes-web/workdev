// /etc/polkit-1/rules.d/50-workdev-agents-ensure.rules
// O usuário workdev (API e healthcheck) pode SÓ iniciar a unidade que garante o
// servidor tmux. Não pode reiniciar nem parar o workdev-agents.service.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" && subject.user == "workdev") {
        if (action.lookup("unit") == "workdev-agents-ensure.service" && action.lookup("verb") == "start") {
            return polkit.Result.YES;
        }
    }
});
