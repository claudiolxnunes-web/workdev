[Unit]
Description=Avisa no Telegram quando a execução do WorkDev Supervisor falha

[Service]
Type=oneshot
WorkingDirectory=/opt/workdev
Environment=HOME=/home/workdev
Environment=PYTHONUNBUFFERED=1
# Sem SUPERVISOR_ENV_FILE: a entrega só precisa do alerta.env (o mesmo bot e
# chat do healthcheck), que o workdev já lê. O arquivo da API não entra aqui.
ExecStart=/opt/workdev/apps/api/venv/bin/python -m scripts.supervisor.entrega
User=workdev
Group=workdev
TimeoutStartSec=60
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=workdev-supervisor-falhou
