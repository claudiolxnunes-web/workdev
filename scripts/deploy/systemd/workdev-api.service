[Unit]
Description=WorkDev API (FastAPI)
After=network.target docker.service

[Service]
User=workdev
Group=workdev
SupplementaryGroups=workdev-runtime
Environment=HOME=/home/workdev
Environment=WORKDEV_API_ENV_FILE=/etc/workdev/workdev-api.env
Environment=WORKDEV_WEB_DIST=/opt/workdev-runtime/current/apps/web/dist
WorkingDirectory=/opt/workdev-runtime/current/apps/api
ExecStart=/opt/workdev/apps/api/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
NoNewPrivileges=true
# The Agent Hub attaches to the workdev-owned tmux socket in /tmp/tmux-<uid>.
# A private /tmp would hide that socket from the API process.
PrivateTmp=false

[Install]
WantedBy=multi-user.target
