[Unit]
Description=WorkDev agents healthcheck
After=workdev-agents.service

[Service]
Type=oneshot
User=workdev
Group=workdev
Environment=HOME=/home/workdev
Environment=WORKDEV_ENV_FILE=/etc/workdev/workdev-api.env
Environment=AGENTS_ALERT_ENV=/etc/workdev/agents-alert.env
WorkingDirectory=/opt/workdev
ExecStart=/opt/workdev/scripts/agents_healthcheck.py --once
