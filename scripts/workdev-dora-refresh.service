[Unit]
Description=WorkDev DORA — Refresh de cache de métricas
Documentation=https://workdev.bpfconsult.com.br
After=workdev-api.service
Requires=workdev-api.service

[Service]
Type=oneshot
ExecStart=/opt/workdev/scripts/refresh_dora_views.sh
WorkingDirectory=/opt/workdev
User=workdev
Group=workdev

# Segredos
Environment="DORA_API_URL=http://127.0.0.1:8000"
EnvironmentFile=/etc/workdev/workdev-api.env

# Observabilidade
SyslogIdentifier=dora-refresh
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dora-refresh
PrivateTmp=true

[Install]
WantedBy=multi-user.target
